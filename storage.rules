rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Public read for all community posts, reels, videos, stories, and profiles
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /profile_pictures/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /posts/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /reels/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /videos/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
