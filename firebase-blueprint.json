{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile in ConnectNP",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of user"
        },
        "name": {
          "type": "string",
          "description": "Display name of user"
        },
        "handle": {
          "type": "string",
          "description": "Unique username / handle"
        },
        "bio": {
          "type": "string",
          "description": "Bio description"
        },
        "walletBalance": {
          "type": "integer",
          "description": "ConnectNP Pay balance in NPR"
        },
        "walletMpin": {
          "type": "string",
          "description": "4-digit security MPIN hash for wallet operations"
        },
        "isBiometricEnabled": {
          "type": "boolean",
          "description": "Whether biometric auth (Fingerprint/Face ID) is enabled"
        },
        "esewaId": {
          "type": "string",
          "description": "Registered eSewa ID mobile number"
        },
        "khaltiNumber": {
          "type": "string",
          "description": "Registered Khalti mobile number"
        },
        "bankAccountNumber": {
          "type": "string",
          "description": "Linked bank account number"
        },
        "bankName": {
          "type": "string",
          "description": "Name of the linked commercial bank in Nepal"
        },
        "bankAccountHolder": {
          "type": "string",
          "description": "Account holder name for bank account"
        },
        "bankBranch": {
          "type": "string",
          "description": "Branch name of linked bank"
        },
        "linkedPaymentMethods": {
          "type": "array",
          "description": "List of user's linked payment methods (eSewa, Khalti, Bank)",
          "items": {
            "type": "object"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp via FieldValue.serverTimestamp()"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp via FieldValue.serverTimestamp()"
        }
      },
      "required": [
        "userId",
        "name",
        "handle",
        "createdAt"
      ]
    },
    "Post": {
      "title": "Post",
      "description": "User created post in ConnectNP",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID"
        },
        "userId": {
          "type": "string",
          "description": "Author UID"
        },
        "authorName": {
          "type": "string",
          "description": "Author display name"
        },
        "authorHandle": {
          "type": "string",
          "description": "Author handle"
        },
        "content": {
          "type": "string",
          "description": "Text body of post"
        },
        "location": {
          "type": "string",
          "description": "Tagged location in Nepal"
        },
        "mediaUrl": {
          "type": "string",
          "description": "Firebase Storage or image URL for photo/video attachment"
        },
        "likesCount": {
          "type": "integer",
          "description": "Number of reactions"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp"
        }
      },
      "required": [
        "userId",
        "authorName",
        "authorHandle",
        "content",
        "createdAt"
      ]
    },
    "MarketItem": {
      "title": "MarketItem",
      "description": "Marketplace listing in ConnectNP",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID"
        },
        "userId": {
          "type": "string",
          "description": "Seller UID"
        },
        "sellerName": {
          "type": "string",
          "description": "Seller name"
        },
        "title": {
          "type": "string",
          "description": "Product title"
        },
        "priceNpr": {
          "type": "integer",
          "description": "Price in Nepalese Rupees"
        },
        "category": {
          "type": "string",
          "description": "Item category"
        },
        "location": {
          "type": "string",
          "description": "Item location"
        },
        "description": {
          "type": "string",
          "description": "Item description"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Listing creation timestamp"
        }
      },
      "required": [
        "userId",
        "sellerName",
        "title",
        "priceNpr",
        "category",
        "location",
        "createdAt"
      ]
    },
    "WalletTransaction": {
      "title": "WalletTransaction",
      "description": "Wallet ledger transaction",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Transaction ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner UID"
        },
        "title": {
          "type": "string",
          "description": "Transaction remarks or title"
        },
        "amount": {
          "type": "integer",
          "description": "Transaction amount in NPR"
        },
        "type": {
          "type": "string",
          "enum": ["credit", "debit"],
          "description": "Transaction type"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Transaction timestamp"
        }
      },
      "required": [
        "userId",
        "title",
        "amount",
        "type",
        "createdAt"
      ]
    },
    "AdminRevenue": {
      "title": "AdminRevenue",
      "description": "Platform monetization revenue and transaction fee accounts",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Account ID"
        },
        "accountName": {
          "type": "string",
          "description": "Account name"
        },
        "totalRevenueNpr": {
          "type": "integer",
          "description": "Total accumulated monetization revenue in NPR"
        },
        "totalTransactionsCount": {
          "type": "integer",
          "description": "Total number of transactions with fees"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": [
        "totalRevenueNpr"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profiles"
    },
    "/posts/{postId}": {
      "schema": {
        "$ref": "#/entities/Post"
      },
      "description": "Social posts feed"
    },
    "/market_items/{itemId}": {
      "schema": {
        "$ref": "#/entities/MarketItem"
      },
      "description": "Marketplace listings"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/WalletTransaction"
      },
      "description": "User wallet transaction ledger"
    },
    "/admin_revenue/{docId}": {
      "schema": {
        "$ref": "#/entities/AdminRevenue"
      },
      "description": "Platform monetization revenue account"
    }
  }
}
